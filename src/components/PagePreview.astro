---
import { ui, type SitePage } from "../data/content";

interface Props { page: SitePage }
const { page } = Astro.props;

// 16px line icons, drawn with currentColor so they follow the button's text colour.
const icon = {
  desktop: '<rect x="1.5" y="2.5" width="13" height="8.5" rx="1"/><path d="M5.5 14h5M8 11v3"/>',
  mobile: '<rect x="4.5" y="1.5" width="7" height="13" rx="1.5"/><path d="M7.25 12.25h1.5"/>',
  full: '<path d="M10 2h4v4M6 14H2v-4M14 2 9.5 6.5M2 14l4.5-4.5"/>',
  cart: '<path d="M1.5 2h2l1.6 8h7.4l1.5-5.5H4.3"/><circle cx="6.5" cy="13" r="1"/><circle cx="11.5" cy="13" r="1"/><path d="M8 6.5h3.5"/>',
  "cart-empty": '<path d="M1.5 2h2l1.6 8h7.4l1.5-5.5H4.3"/><circle cx="6.5" cy="13" r="1"/><circle cx="11.5" cy="13" r="1"/>',
};
const svg = (d: string) => `<svg class="ico" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${d}</svg>`;

// The switchable views shown in the bar: page states, or desktop/mobile.
const views = page.variants
  ? page.variants.map((v) => ({ label: v.label, img: v.img, icon: icon[v.icon], narrow: !!page.phone }))
  : page.mobile
    ? [
        { label: ui.desktop, img: page.img, icon: icon.desktop, narrow: false },
        { label: ui.mobile, img: page.mobile, icon: icon.mobile, narrow: true },
      ]
    : null;
---
<section id={page.id} data-name={page.name} data-img={page.img} data-label="" data-narrow={page.phone ? "true" : undefined}>
  <h2>{page.name}{page.tag && <span class="tag">{page.tag}</span>}</h2>
  <p class="lead">{page.purpose}</p>
  <div class="viewer">
    <div class="vbar">
      {views ? (
        <div class="seg" role="group" aria-label={page.variants ? page.name : ui.device}>
          {views.map((v, i) => (
            <button type="button" aria-pressed={i === 0 ? "true" : "false"} data-src={v.img} data-narrow={v.narrow ? "true" : undefined} data-label={i === 0 ? "" : v.label}>
              <Fragment set:html={svg(v.icon)} />{v.label}
            </button>
          ))}
        </div>
      ) : (
        <div class="seg"><span class="seg-label"><Fragment set:html={svg(page.phone ? icon.mobile : icon.desktop)} />{page.phone ? ui.mobile : ui.desktop}</span></div>
      )}
      <button type="button" class="open" data-open><Fragment set:html={svg(icon.full)} />{ui.fullScreen}</button>
    </div>
    <div class:list={["frame", { mobile: page.phone }]} data-open tabindex="0" aria-label={`${page.name}: κάντε κύλιση για να δείτε περισσότερα`}>
      <img src={page.img} alt={`Σχέδιο σελίδας: ${page.name}`} loading="lazy" />
    </div>
  </div>
</section>
